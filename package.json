{
  "name": "article-to-remotion-codex",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts NewsVideo out/news-video.mp4 --props=video.json --codec=h264",
